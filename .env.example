# ── Calorie AI mobile — biến môi trường (sao chép file này thành .env rồi điền) ──
# LƯU Ý: biến có tiền tố EXPO_PUBLIC_ được nhúng thẳng vào bundle; các biến LLM_*
# bên dưới KHÔNG cần tiền tố vì app.config.js đọc chúng lúc build (qua `extra`).
# Đổi .env xong nhớ khởi động lại Metro: npx expo start -c

# (tuỳ chọn) Ghi đè base URL backend
# EXPO_PUBLIC_API_BASE_URL=https://tht-d3.vercel.app/api

# ── Trợ lý AI (AI Agent) gọi THẲNG vLLM — né trần 60s của Vercel Hobby ──
# Cùng bộ biến với backend THT-D3 (lib/llm.js). Nếu bạn kéo env bằng
# `vercel env pull` thì .env đã có sẵn 3 biến này, không cần làm gì thêm.
# Thiếu LLM_BASE_URL → Trợ lý tự dùng đường backend /chat như cũ.
# LLM_BASE_URL=https://<vllm-server>/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=qwen2.5-vl
# (tuỳ chọn) Override tường minh phía client — được ƯU TIÊN hơn LLM_*:
# EXPO_PUBLIC_LLM_BASE_URL=
# EXPO_PUBLIC_LLM_API_KEY=
# EXPO_PUBLIC_LLM_MODEL=

# ── Wake word "Xin chào Calorie" (Picovoice Porcupine, ON-DEVICE) ──
# CẦN: EAS/dev build (KHÔNG chạy Expo Go). Thiếu key → rảnh tay tự tắt, nút "chạm để nói" vẫn chạy.
# 1) AccessKey miễn phí: https://console.picovoice.ai
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=

# 2) File "Xin chào Calorie" .ppn (train ở Console, ngôn ngữ Vietnamese) — bundle vào app:
#    Android: android/app/src/main/assets/   |   iOS: thêm vào Xcode Resources
EXPO_PUBLIC_WAKE_KEYWORD_ANDROID=xin-chao-calorie_android.ppn
EXPO_PUBLIC_WAKE_KEYWORD_IOS=xin-chao-calorie_ios.ppn

# 3) Model ngôn ngữ Vietnamese (porcupine_params_vi.pv) — cũng bundle như trên:
EXPO_PUBLIC_WAKE_MODEL_ANDROID=porcupine_params_vi_android.pv
EXPO_PUBLIC_WAKE_MODEL_IOS=porcupine_params_vi_ios.pv

# 4) (tuỳ chọn) Độ nhạy 0..1 (cao = dễ kích hoạt hơn nhưng nhiều báo nhầm hơn)
EXPO_PUBLIC_WAKE_SENSITIVITY=0.6

# (tuỳ chọn) Khi CHƯA có .ppn: tạm dùng từ khoá dựng sẵn tiếng Anh để test (mặc định JARVIS)
# EXPO_PUBLIC_WAKEWORD_BUILTIN=JARVIS
